# GameSage AI provider configuration.
# Copy to `.env` (git-ignored) and fill in real values. Never commit keys.
# Environment variables already present in your system always override
# values defined here.

# ------------------------------------------------------------------
# Provider selection (required)
#
# One of:
#   openai_compatible  any OpenAI-compatible endpoint, incl. local servers
#   openai             official OpenAI API
#   openrouter         OpenRouter aggregator
#   zai                Z.AI general API
# ------------------------------------------------------------------
GAMESAGE_AI_PROVIDER=openai_compatible

# ------------------------------------------------------------------
# Generic OpenAI-compatible endpoint (also used for local servers)
#
# Works with any endpoint exposing OpenAI-style /chat/completions with
# image support (LM Studio, vLLM, Ollama's OpenAI endpoint, gateways...).
# The API key is optional: leave it empty for endpoints without auth.
# The model must be vision-capable (image + text input).
# ------------------------------------------------------------------
GAMESAGE_AI_BASE_URL=http://127.0.0.1:1234/v1
GAMESAGE_AI_API_KEY=
GAMESAGE_AI_MODEL=

# ------------------------------------------------------------------
# OpenAI (uncomment and set GAMESAGE_AI_PROVIDER=openai)
# ------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# # Optional base URL override:
# # OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------
# OpenRouter (uncomment and set GAMESAGE_AI_PROVIDER=openrouter)
#
# The model is always required; pick any vision-capable model id from
# https://openrouter.ai/models
# ------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ------------------------------------------------------------------
# Z.AI general API (uncomment and set GAMESAGE_AI_PROVIDER=zai)
#
# Note: the Z.AI Coding Plan endpoint is NOT supported as a runtime
# backend; only the general API above.
# ------------------------------------------------------------------
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_VISION_MODEL=glm-4.5v
